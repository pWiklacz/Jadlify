+using Jadlify.Application.Common.Mediator;
+using Jadlify.Application.Shopping.Contracts;
+using Jadlify.Domain.Shopping;
+using Jadlify.SharedKernel;
+
+namespace Jadlify.Application.Shopping.GetSharedShoppingList;
+
+public sealed class GetSharedShoppingListQueryHandler
+    : IQueryHandler<GetSharedShoppingListQuery, ShoppingListDetailDto>
+{
+    private readonly IShoppingListRepository _lists;
+
+    public GetSharedShoppingListQueryHandler(IShoppingListRepository lists)
+    {
+        _lists = lists;
+    }
+
+    public async Task<Result<ShoppingListDetailDto>> HandleAsync(
+        GetSharedShoppingListQuery query,
+        CancellationToken cancellationToken)
+    {
+        // Shared lists are readable by anyone who has the link, so we look the
+        // list up by id alone instead of scoping it to the current user.
+        ShoppingList? list = await _lists.GetByIdWithoutOwnerAsync(
+            query.ListId,
+            cancellationToken);
+
+        return list is null
+            ? Result.Fail<ShoppingListDetailDto>(ShoppingListErrors.NotFound)
+            : Result.Ok(ShoppingListDetailDto.FromDomain(list));
+    }
+}
