+namespace Jadlify.SharedKernel.Time;
+
+/// <summary>
+/// Half-open range [Start, End) covering the ISO-8601 week that contains a date.
+/// Weeks start on Monday regardless of the caller's culture.
+/// </summary>
+public readonly record struct WeekRange(DateOnly Start, DateOnly End)
+{
+    public static WeekRange Containing(DateOnly date)
+    {
+        var offset = ((int)date.DayOfWeek + 6) % 7;
+        var start = date.AddDays(-offset);
+        return new WeekRange(start, start.AddDays(7));
+    }
+
+    public bool Contains(DateOnly date) => date >= Start && date < End;
+
+    /// <summary>
+    /// ISO-8601 week number. The week belongs to the year that owns its Thursday,
+    /// so the first days of January can fall in week 52 or 53 of the prior year.
+    /// </summary>
+    public int IsoWeekNumber()
+    {
+        var thursday = Start.AddDays(3);
+        var jan1 = new DateOnly(thursday.Year, 1, 1);
+        var jan1Offset = ((int)jan1.DayOfWeek + 6) % 7;
+        var firstThursday = jan1.AddDays(jan1Offset <= 3 ? -jan1Offset + 3 : 7 - jan1Offset + 3);
+        return (thursday.DayNumber - firstThursday.DayNumber) / 7 + 1;
+    }
+
+    /// <summary>
+    /// Splits an arbitrary span into whole weeks. A partial week at either end is
+    /// returned clipped, so callers can page a meal plan without losing days.
+    /// </summary>
+    public static IReadOnlyList<WeekRange> Split(DateOnly from, DateOnly to)
+    {
+        if (to < from)
+        {
+            return [];
+        }
+
+        var weeks = new List<WeekRange>();
+        var cursor = Containing(from);
+        while (cursor.Start < to)
+        {
+            var clippedStart = cursor.Start < from ? from : cursor.Start;
+            var clippedEnd = cursor.End > to ? to : cursor.End;
+            weeks.Add(new WeekRange(clippedStart, clippedEnd));
+            cursor = new WeekRange(cursor.End, cursor.End.AddDays(7));
+        }
+
+        return weeks;
+    }
+}
